# MongoDB Connection string (e.g., MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reservation_system?retryWrites=true&w=majority

# Database Name (default: reservation_system)
DB_NAME=reservation_system

# JWT Secret Key for token signing
JWT_SECRET_KEY=airline-railway-super-secret-key-2024

# Port (set automatically by Render)
PORT=5000

# Flask debug mode (set to False in production)
FLASK_DEBUG=False

